# Instagram (API oficial da Meta, recurso Business Discovery)
# ID da SUA conta profissional do Instagram (não é o @, é o número)
IG_USER_ID=
# Token de acesso de longa duração com instagram_basic + pages_show_list + business_management
IG_ACCESS_TOKEN=
# Versão da Graph API
IG_GRAPH_VERSION=v27.0

# Claude (análise qualitativa). Sem ela, a plataforma usa uma análise básica automática.
ANTHROPIC_API_KEY=

# Opt-in (análise completa com login do Instagram)
# App ID e App Secret do produto "API do Instagram com login do Instagram" (não é o mesmo ID do app do Facebook)
IG_APP_ID=
IG_APP_SECRET=
# Endereço público da plataforma, sem barra no final (ex.: https://perfilab.vercel.app)
APP_URL=http://localhost:3000
